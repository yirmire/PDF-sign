<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Signer Pro - Assine e Contribua</title>
    <!-- Bibliotecas -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .signature-pad-container { touch-action: none; }
        #pdf-canvas {
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
            max-width: 100%;
            height: auto !important;
        }
        .signature-overlay {
            cursor: move;
            z-index: 10;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center sticky top-0 z-40 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="bg-blue-600 p-2 rounded-xl text-white shadow-blue-200 shadow-lg">
                <i data-lucide="pen-tool" class="w-6 h-6"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold tracking-tight text-slate-900 leading-none">PDF Signer Pro</h1>
                <span class="text-[10px] text-blue-600 font-bold uppercase tracking-wider">Web Edition</span>
            </div>
        </div>
        
        <div class="flex items-center gap-4">
            <button onclick="toggleDonateModal()" class="hidden md:flex items-center gap-2 text-rose-500 bg-rose-50 hover:bg-rose-100 px-4 py-2 rounded-lg font-semibold transition-all border border-rose-100">
                <i data-lucide="heart" class="w-4 h-4 fill-rose-500"></i>
                Contribuir
            </button>
            <div id="action-buttons" class="hidden flex items-center gap-3 border-l pl-4 border-slate-200">
                <button id="btn-download" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-bold transition-all shadow-md active:scale-95">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span id="btn-download-text">Finalizar</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 p-4 md:p-8 flex flex-col lg:flex-row gap-8 max-w-7xl mx-auto w-full">
        <!-- Sidebar -->
        <aside class="w-full lg:w-80 flex flex-col gap-6">
            <!-- Passo 1: Arquivo -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4 flex items-center gap-2">
                    <span class="bg-slate-100 w-5 h-5 rounded-full flex items-center justify-center text-[10px]">1</span> 
                    Documento
                </h2>
                <div id="upload-zone">
                    <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-slate-200 rounded-xl cursor-pointer hover:border-blue-400 hover:bg-blue-50/30 transition-all group">
                        <i data-lucide="upload" class="w-8 h-8 text-slate-300 group-hover:text-blue-500 mb-2 transition-colors"></i>
                        <span class="text-sm font-medium text-slate-500 group-hover:text-blue-600">Escolher PDF</span>
                        <input type="file" id="pdf-input" class="hidden" accept=".pdf" />
                    </label>
                </div>
                <div id="file-info" class="hidden flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200">
                    <div class="flex items-center gap-2 overflow-hidden">
                        <i data-lucide="file-text" class="w-4 h-4 text-blue-500 flex-shrink-0"></i>
                        <span id="file-name" class="text-sm font-medium truncate italic text-slate-600">nome.pdf</span>
                    </div>
                    <button id="btn-remove-file" class="text-slate-400 hover:text-red-500 p-1">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- Passo 2: Assinatura -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4 flex items-center gap-2">
                    <span class="bg-slate-100 w-5 h-5 rounded-full flex items-center justify-center text-[10px]">2</span> 
                    Assinatura
                </h2>
                <div id="no-signature">
                    <button id="btn-open-modal" class="w-full py-3 px-4 flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-semibold transition-all shadow-lg active:scale-95">
                        <i data-lucide="signature" class="w-4 h-4"></i>
                        Criar Assinatura
                    </button>
                </div>
                <div id="has-signature" class="hidden flex flex-col gap-4">
                    <div class="border border-slate-200 rounded-xl p-4 bg-white flex items-center justify-center relative group min-h-[100px]">
                        <img id="signature-preview" src="" alt="Assinatura" class="max-h-20" />
                        <button id="btn-new-signature" class="absolute inset-0 bg-slate-900/10 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity rounded-xl">
                             <span class="bg-white text-slate-900 px-3 py-1 rounded-full text-xs font-bold shadow-sm">Alterar</span>
                        </button>
                    </div>
                    <p class="text-[10px] text-slate-400 text-center italic">Clique no documento para aplicar esta assinatura</p>
                </div>
            </div>

            <!-- Lista de Assinaturas -->
            <div id="signatures-list-container" class="hidden bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Aplicadas</h2>
                <div id="signatures-list" class="space-y-2 max-h-40 overflow-y-auto pr-2"></div>
            </div>

            <!-- Card Donate Lateral -->
            <div class="mt-auto bg-gradient-to-br from-blue-600 to-indigo-700 p-6 rounded-2xl text-white shadow-xl">
                <h3 class="font-bold mb-2 flex items-center gap-2">
                    <i data-lucide="coffee" class="w-4 h-4"></i> Apoie o Projeto
                </h3>
                <p class="text-xs text-blue-100 mb-4 leading-relaxed">Ajude a manter este projeto gratuito e sem anúncios para todos.</p>
                <button onclick="toggleDonateModal()" class="w-full py-2 bg-white text-blue-600 rounded-lg font-bold text-sm hover:bg-blue-50 transition-colors">
                    Fazer uma Doação
                </button>
            </div>
        </aside>

        <!-- Visualizador -->
        <section class="flex-1 flex flex-col items-center gap-4">
            <div id="empty-state" class="flex-1 w-full border-2 border-dashed border-slate-200 rounded-3xl flex flex-col items-center justify-center bg-white text-slate-300 min-h-[500px]">
                <div class="bg-slate-50 p-6 rounded-full mb-4">
                    <i data-lucide="file-up" class="w-16 h-16 opacity-20"></i>
                </div>
                <p class="text-lg font-bold text-slate-400">Pronto para começar?</p>
                <p class="text-sm">Carregue um PDF para visualizar e assinar.</p>
            </div>

            <div id="pdf-viewer" class="hidden w-full flex flex-col items-center gap-4">
                <div class="flex items-center gap-6 bg-white px-6 py-3 rounded-2xl shadow-sm border border-slate-200">
                    <button id="btn-prev-page" class="p-2 hover:bg-slate-100 rounded-xl disabled:opacity-20 transition-colors">
                        <i data-lucide="chevron-left" class="w-6 h-6"></i>
                    </button>
                    <div class="flex flex-col items-center">
                        <span id="page-info" class="text-sm font-bold text-slate-700">Página 1 de 1</span>
                        <span class="text-[10px] text-slate-400 uppercase font-bold tracking-tighter">Visualização Real</span>
                    </div>
                    <button id="btn-next-page" class="p-2 hover:bg-slate-100 rounded-xl disabled:opacity-20 transition-colors">
                        <i data-lucide="chevron-right" class="w-6 h-6"></i>
                    </button>
                </div>

                <div id="viewport-container" class="relative bg-slate-200/50 p-4 md:p-8 rounded-2xl overflow-auto w-full flex justify-center border border-slate-200 shadow-inner min-h-[600px]">
                    <div id="pdf-render-wrapper" class="relative inline-block shadow-2xl bg-white">
                        <canvas id="pdf-canvas"></canvas>
                        <!-- Assinaturas flutuantes entram aqui -->
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal de Assinatura -->
    <div id="signature-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/80 backdrop-blur-md p-4">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-200">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="font-bold text-lg text-slate-900">Desenhe sua Assinatura</h3>
                <button onclick="closeModal('signature-modal')" class="p-2 hover:bg-white rounded-full text-slate-400 transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="p-8">
                <div class="bg-white border-2 border-slate-200 rounded-2xl overflow-hidden touch-none relative shadow-inner">
                    <canvas id="signature-pad" width="800" height="400" class="w-full cursor-crosshair"></canvas>
                </div>
                <div class="flex gap-4 mt-8">
                    <button id="btn-clear-canvas" class="flex-1 py-4 px-6 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold rounded-2xl transition-all">
                        Limpar
                    </button>
                    <button id="btn-save-canvas" class="flex-1 py-4 px-6 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl transition-all shadow-lg active:scale-95">
                        Salvar e Usar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Doação -->
    <div id="donate-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/80 backdrop-blur-md p-4">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-slate-200">
            <div class="p-8 text-center">
                <div class="bg-rose-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i data-lucide="heart" class="w-10 h-10 text-rose-500 fill-rose-500"></i>
                </div>
                <h3 class="text-2xl font-bold text-slate-900 mb-2">Gostou da ferramenta?</h3>
                <p class="text-slate-500 mb-8">Este é um projeto open-source e gratuito. Sua contribuição ajuda a manter o servidor e as atualizações.</p>
                
                <div class="space-y-3">
                    <button onclick="window.open('https://www.paypal.com', '_blank')" class="w-full py-4 bg-[#0070ba] text-white rounded-2xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
                        Doar via PayPal
                    </button>
                    <button onclick="copyPix()" class="w-full py-4 bg-emerald-500 text-white rounded-2xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
                        <i data-lucide="copy" class="w-4 h-4"></i> Copiar Chave PIX
                    </button>
                </div>
                
                <button onclick="closeModal('donate-modal')" class="mt-6 text-slate-400 font-medium hover:text-slate-600">Talvez mais tarde</button>
            </div>
        </div>
    </div>

    <script>
        // --- Configurações PDF.js ---
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

        // --- Estado ---
        const state = {
            pdfBytes: null,
            pdfFile: null,
            pdfDoc: null, // pdfjs instance
            signatureImage: null,
            placedSignatures: [],
            currentPage: 1,
            numPages: 0,
            isDrawing: false,
            scale: 1.5 // Zoom do render
        };

        // --- Seletores ---
        const pdfInput = document.getElementById('pdf-input');
        const pdfCanvas = document.getElementById('pdf-canvas');
        const pdfCtx = pdfCanvas.getContext('2d');
        const sigCanvas = document.getElementById('signature-pad');
        const sigCtx = sigCanvas.getContext('2d');

        // --- Inicialização ---
        lucide.createIcons();

        // --- Renderização de PDF Real ---
        async function renderPage(num) {
            const page = await state.pdfDoc.getPage(num);
            const viewport = page.getViewport({ scale: state.scale });
            
            pdfCanvas.height = viewport.height;
            pdfCanvas.width = viewport.width;

            const renderContext = {
                canvasContext: pdfCtx,
                viewport: viewport
            };

            await page.render(renderContext).promise;
            updateUI();
        }

        function updateUI() {
            // Visibilidade básica
            if (state.pdfFile) {
                document.getElementById('upload-zone').classList.add('hidden');
                document.getElementById('file-info').classList.remove('hidden');
                document.getElementById('file-name').textContent = state.pdfFile.name;
                document.getElementById('pdf-viewer').classList.remove('hidden');
                document.getElementById('empty-state').classList.add('hidden');
                document.getElementById('action-buttons').classList.remove('hidden');
            }

            if (state.signatureImage) {
                document.getElementById('no-signature').classList.add('hidden');
                document.getElementById('has-signature').classList.remove('hidden');
                document.getElementById('signature-preview').src = state.signatureImage;
            }

            document.getElementById('page-info').textContent = `Página ${state.currentPage} de ${state.numPages}`;
            document.getElementById('btn-prev-page').disabled = state.currentPage <= 1;
            document.getElementById('btn-next-page').disabled = state.currentPage >= state.numPages;

            renderOverlays();
        }

        function renderOverlays() {
            const wrapper = document.getElementById('pdf-render-wrapper');
            const overlays = wrapper.querySelectorAll('.signature-overlay');
            overlays.forEach(o => o.remove());

            const currentSigs = state.placedSignatures.filter(s => s.page === state.currentPage);
            const list = document.getElementById('signatures-list');
            list.innerHTML = '';

            if (state.placedSignatures.length > 0) {
                document.getElementById('signatures-list-container').classList.remove('hidden');
                state.placedSignatures.forEach((sig, i) => {
                    const item = document.createElement('div');
                    item.className = 'flex items-center justify-between p-2 text-[11px] bg-slate-50 rounded-lg border border-slate-100';
                    item.innerHTML = `<span>Assinatura ${i+1} (Pág ${sig.page})</span> <button onclick="removeSig(${sig.id})" class="text-rose-400 hover:text-rose-600"><i data-lucide="trash-2" class="w-3 h-3"></i></button>`;
                    list.appendChild(item);
                });
            }

            currentSigs.forEach(sig => {
                const img = document.createElement('div');
                img.className = 'signature-overlay absolute group';
                img.style.left = `${sig.x}px`;
                img.style.top = `${sig.y}px`;
                img.style.width = '120px'; // Tamanho fixo visual
                img.innerHTML = `<img src="${sig.image}" class="w-full h-auto" />`;
                wrapper.appendChild(img);
            });
            lucide.createIcons();
        }

        // --- Handlers de Arquivo ---
        pdfInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file && file.type === 'application/pdf') {
                state.pdfFile = file;
                state.pdfBytes = await file.arrayBuffer();
                
                const loadingTask = pdfjsLib.getDocument({ data: state.pdfBytes });
                state.pdfDoc = await loadingTask.promise;
                state.numPages = state.pdfDoc.numPages;
                state.currentPage = 1;
                state.placedSignatures = [];
                
                renderPage(state.currentPage);
            }
        });

        document.getElementById('btn-remove-file').addEventListener('click', () => { location.reload(); });

        // --- Navegação ---
        document.getElementById('btn-prev-page').addEventListener('click', () => {
            if (state.currentPage > 1) { state.currentPage--; renderPage(state.currentPage); }
        });
        document.getElementById('btn-next-page').addEventListener('click', () => {
            if (state.currentPage < state.numPages) { state.currentPage++; renderPage(state.currentPage); }
        });

        // --- Assinatura (Pad) ---
        function getPos(e) {
            const rect = sigCanvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (clientX - rect.left) * (sigCanvas.width / rect.width),
                y: (clientY - rect.top) * (sigCanvas.height / rect.height)
            };
        }

        sigCanvas.addEventListener('mousedown', (e) => { state.isDrawing = true; sigCtx.beginPath(); const p = getPos(e); sigCtx.moveTo(p.x, p.y); });
        sigCanvas.addEventListener('mousemove', (e) => { 
            if(!state.isDrawing) return; 
            const p = getPos(e); 
            sigCtx.lineTo(p.x, p.y); 
            sigCtx.strokeStyle = "#000"; 
            sigCtx.lineWidth = 4; 
            sigCtx.stroke(); 
        });
        window.addEventListener('mouseup', () => state.isDrawing = false);

        document.getElementById('btn-open-modal').onclick = () => { document.getElementById('signature-modal').classList.replace('hidden', 'flex'); sigCtx.clearRect(0,0,800,400); };
        document.getElementById('btn-new-signature').onclick = () => { document.getElementById('signature-modal').classList.replace('hidden', 'flex'); sigCtx.clearRect(0,0,800,400); };
        document.getElementById('btn-clear-canvas').onclick = () => sigCtx.clearRect(0,0,800,400);
        document.getElementById('btn-save-canvas').onclick = () => {
            state.signatureImage = sigCanvas.toDataURL();
            closeModal('signature-modal');
            updateUI();
        };

        // --- Colocar Assinatura no PDF ---
        document.getElementById('pdf-render-wrapper').addEventListener('click', (e) => {
            if(!state.signatureImage) return;
            const rect = document.getElementById('pdf-render-wrapper').getBoundingClientRect();
            const x = e.clientX - rect.left - 60; // centraliza
            const y = e.clientY - rect.top - 30;

            state.placedSignatures.push({
                id: Date.now(),
                x, y,
                page: state.currentPage,
                image: state.signatureImage
            });
            updateUI();
        });

        window.removeSig = (id) => {
            state.placedSignatures = state.placedSignatures.filter(s => s.id !== id);
            updateUI();
        };

        // --- Exportação ---
        document.getElementById('btn-download').onclick = async () => {
            const btnText = document.getElementById('btn-download-text');
            btnText.textContent = "Gravando...";
            
            try {
                const pdfLibDoc = await PDFLib.PDFDocument.load(state.pdfBytes);
                const pages = pdfLibDoc.getPages();

                for (const sig of state.placedSignatures) {
                    const page = pages[sig.page - 1];
                    const { width, height } = page.getSize();
                    
                    const renderW = pdfCanvas.width;
                    const renderH = pdfCanvas.height;

                    // Converte coordenadas da tela para o PDF (Invertendo Y)
                    const pdfX = (sig.x / renderW) * width;
                    const pdfY = height - ((sig.y + 60) / renderH) * height;

                    const sigImg = await pdfLibDoc.embedPng(sig.image);
                    page.drawImage(sigImg, {
                        x: pdfX,
                        y: pdfY,
                        width: (120 / renderW) * width,
                        height: (60 / renderH) * height
                    });
                }

                const bytes = await pdfLibDoc.save();
                const blob = new Blob([bytes], {type: 'application/pdf'});
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `assinado_${state.pdfFile.name}`;
                a.click();
                btnText.textContent = "Sucesso!";
                setTimeout(() => btnText.textContent = "Finalizar", 2000);
            } catch (err) {
                console.error(err);
                alert("Erro ao gravar assinaturas.");
                btnText.textContent = "Erro";
            }
        };

        // --- Funções Auxiliares ---
        window.closeModal = (id) => document.getElementById(id).classList.replace('flex', 'hidden');
        window.toggleDonateModal = () => {
            const m = document.getElementById('donate-modal');
            m.classList.contains('hidden') ? m.classList.replace('hidden', 'flex') : m.classList.replace('flex', 'hidden');
        };
        window.copyPix = () => {
            const chave = "suachavepixaqui@email.com";
            const el = document.createElement('textarea');
            el.value = chave;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            alert("Chave PIX copiada! Obrigado pelo apoio.");
        };
    </script>
</body>
</html>
